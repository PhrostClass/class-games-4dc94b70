     {"t": "choose", "q": "He is wearing ___ scarf.", "opts": ["two", "a"], "a": "a", "why": "One scarf, so a scarf."},
     {"t": "choose", "q": "She is wearing ___.", "opts": ["a boots", "boot", "boots"], "a": "boots", "why": "Two boots, so no a and add -s."},
     {"t": "choose", "q": "He's wearing a ___.", "opts": ["jumper green", "green jumper"], "a": "green jumper", "why": "The colour goes before the noun."},
     {"t": "choose", "q": "I ___ wearing my mittens.", "opts": ["am", "is", "are"], "a": "am", "why": "After I we say am."},
     {"t": "choose", "q": "She is wearing ___ trousers.", "opts": ["a", "blacks", "black"], "a": "black", "why": "No a with trousers. Colours never take -s."},
     {"t": "write", "q": "The snowman is ___ (wear) a scarf.", "a": ["wearing"], "why": "After is we say wearing."},
     {"t": "write", "q": "It is cold. He ___ (be) wearing a jacket.", "a": ["is"], "why": "After He we say is."},
     {"t": "write", "q": "She is wearing two ___ (sock).", "a": ["socks"], "why": "Two things, so add -s."},
     {"t": "write", "q": "They ___ (be) wearing boots.", "a": ["are"], "why": "After They we say are."},
     {"t": "order", "q": "a / wearing / scarf / he's / red", "a": ["He's wearing a red scarf."], "why": "The colour goes before the noun."},
