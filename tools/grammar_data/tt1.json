   ]},
  {"n": 9, "title": "I am wearing...; The lion is running",
   "notes": ["Use am, is or are + verb-ing for now: I am wearing a hat.", "What are you wearing? I am wearing a blue scarf.", "What is the frog doing? The frog is jumping."],
   "items": [
     {"t": "choose", "q": "I ___ wearing a purple jumper.", "opts": ["is", "am", "are"], "a": "am", "why": "After I we say am."},
     {"t": "choose", "q": "What ___ you wearing?", "opts": ["are", "is", "am"], "a": "are", "why": "With you we say are."},
     {"t": "choose", "q": "What is she ___?", "opts": ["wear", "wears", "wearing"], "a": "wearing", "why": "After is we use the -ing form."},
     {"t": "choose", "q": "Is she wearing a scarf? Yes, she ___.", "opts": ["is", "are", "wearing"], "a": "is", "why": "Yes, she is."},
     {"t": "choose", "q": "What are you wearing? ___ wearing a grey hat.", "opts": ["I", "I'm", "I is"], "a": "I'm", "why": "I'm is I am. We need am."},
     {"t": "choose", "q": "The lion is ___ fast.", "opts": ["run", "running", "runs"], "a": "running", "why": "After is we use the -ing form."},
     {"t": "choose", "q": "The frog ___ jumping.", "opts": ["are", "am", "is"], "a": "is", "why": "One frog, so is."},
     {"t": "choose", "q": "What is the monkey doing? It is ___.", "opts": ["eating", "eat", "eats"], "a": "eating", "why": "After is we use the -ing form."},
     {"t": "choose", "q": "What is the koala ___?", "opts": ["do", "doing", "does"], "a": "doing", "why": "The question is What is it doing?"},
     {"t": "choose", "q": "___ the birds flying? Yes, they are.", "opts": ["Is", "Do", "Are"], "a": "Are", "why": "Birds are two or more, so Are."},
     {"t": "choose", "q": "The crocodile is ___.", "opts": ["swiming", "swimming", "swim"], "a": "swimming", "why": "Swim has double m before -ing."},
     {"t": "choose", "q": "Are you wearing boots? No, I ___.", "opts": ["aren't", "am not", "isn't"], "a": "am not", "why": "With I we say am not."},
     {"t": "choose", "q": "The tiger ___ walking. It is sleeping.", "opts": ["isn't", "aren't", "is"], "a": "isn't", "why": "It is sleeping, so it isn't walking."},
     {"t": "choose", "q": "What ___ the elephants doing?", "opts": ["is", "are", "am"], "a": "are", "why": "Two or more elephants, so are."},
     {"t": "write", "q": "Look! The giraffe is ___ (eat) leaves.", "a": ["eating"], "why": "After is we use the -ing form."},
     {"t": "write", "q": "It is snowing. I ___ (be) wearing boots.", "a": ["am"], "why": "After I we say am."},
     {"t": "write", "q": "The hippo is ___ (swim) now.", "a": ["swimming"], "why": "Swim has double m before -ing."},
     {"t": "write", "q": "The monkeys ___ (be) jumping now.", "a": ["are"], "why": "Two or more monkeys, so are."},
     {"t": "order", "q": "wearing / you / today / what / are", "a": ["What are you wearing today?"], "why": "What + are + you + wearing."},
     {"t": "order", "q": "running / the / very / is / fast / lion", "a": ["The lion is running very fast.", "Is the lion running very fast?"], "why": ""}
   ]},
  {"n": 10, "title": "Present continuous; has got",
   "notes": ["Use is or are + verb-ing for now: The giraffe is eating leaves.", "One animal takes is. Two or more animals take are.", "Use has got for one animal: The elephant has got big ears.", "The adjective goes before the noun: long legs, not legs long."],
   "items": [
     {"t": "choose", "q": "The monkeys ___ jumping in the trees.", "opts": ["is", "are", "am"], "a": "are", "why": "Two or more monkeys, so are."},
     {"t": "choose", "q": "The zebra ___ eating grass.", "opts": ["is", "are", "am"], "a": "is", "why": "One zebra, so is."},
     {"t": "choose", "q": "The hippo is ___ slowly.", "opts": ["walk", "walks", "walking"], "a": "walking", "why": "After is we use the -ing form."},
     {"t": "choose", "q": "What are the lions doing? ___ are sleeping.", "opts": ["It", "They", "He"], "a": "They", "why": "The lions are two or more, so They."},
     {"t": "choose", "q": "Is the tiger hiding? Yes, it ___.", "opts": ["are", "does", "is"], "a": "is", "why": "Yes, it is."},
     {"t": "choose", "q": "The birds ___ swimming. They are flying.", "opts": ["aren't", "isn't", "are"], "a": "aren't", "why": "They are flying, so they aren't swimming."},
     {"t": "choose", "q": "The monkey is ___ in a tree.", "opts": ["siting", "sitting", "sit"], "a": "sitting", "why": "Sit has double t before -ing."},
     {"t": "choose", "q": "The giraffe ___ got a long tongue.", "opts": ["have", "is", "has"], "a": "has", "why": "One animal, so has got."},
     {"t": "choose", "q": "The tiger has ___ big teeth.", "opts": ["got", "get", "have"], "a": "got", "why": "We say has got."},
     {"t": "choose", "q": "The hippo has got ___.", "opts": ["ears small", "small ears", "smalls ears"], "a": "small ears", "why": "The adjective goes first and has no -s."},
     {"t": "choose", "q": "The elephant has got ___ ears.", "opts": ["bigs", "a big", "big"], "a": "big", "why": "Adjectives never take -s. Ears is plural, so no a."},
     {"t": "choose", "q": "The zebra has got four ___.", "opts": ["legs", "leg"], "a": "legs", "why": "Four things, so add -s."},
     {"t": "choose", "q": "The monkey ___ two hands.", "opts": ["have got", "has got", "is got"], "a": "has got", "why": "One monkey, so has got."},
     {"t": "choose", "q": "The crocodile ___ got long legs. It has got short legs.", "opts": ["hasn't", "haven't", "isn't"], "a": "hasn't", "why": "The negative of has got is hasn't got."},
     {"t": "write", "q": "Look! The tigers are ___ (hide).", "a": ["hiding"], "why": "Hide loses the e before -ing."},
     {"t": "write", "q": "The giraffe is ___ (stand) now.", "a": ["standing"], "why": "After is we use the -ing form."},
     {"t": "write", "q": "The crocodile ___ (have) got big teeth.", "a": ["has"], "why": "One animal, so has got."},
     {"t": "write", "q": "Look! The elephants ___ (be) walking.", "a": ["are"], "why": "Two or more elephants, so are."},
     {"t": "order", "q": "got / the / teeth / has / lion / big", "a": ["The lion has got big teeth.", "Has the lion got big teeth?"], "why": "The adjective goes before the noun."},
     {"t": "order", "q": "eating / monkeys / are / bananas / the", "a": ["The monkeys are eating bananas.", "Are the monkeys eating bananas?"], "why": ""}
   ]}
]}
